# Copy to backend/.env and fill in real values. Never commit backend/.env.
# With docker compose, DATABASE_URL and TEST_DATABASE_URL are overridden to point at the db container.

DATABASE_URL=sqlite:///./bastet.db

GEOAPI_KEY=change-me

ADMIN_AUTH_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

AUTH_SECRET=change-me
ADOPTANT_SECRET=change-me

CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

FRONTEND_URL=http://localhost:5173
PORTAL_BASE_URL=http://localhost:5173
